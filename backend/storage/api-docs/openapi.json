{
    "openapi": "3.0.0",
    "info": {
        "title": "Fishbook API",
        "version": "1.0.0"
    },
    "servers": [
        {
            "url": "/api/v1"
        }
    ],
    "paths": {
        "/auth/register": {
            "post": {
                "tags": [
                    "auth"
                ],
                "summary": "Register a new local user",
                "operationId": "authRegister",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/RegisterRequest"
                            }
                        }
                    }
                },
                "responses": {
                    "201": {
                        "description": "Created",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/AuthTokenResponse"
                                }
                            }
                        }
                    },
                    "422": {
                        "description": "Validation error"
                    },
                    "429": {
                        "description": "Rate limited"
                    }
                }
            }
        },
        "/auth/login": {
            "post": {
                "tags": [
                    "auth"
                ],
                "summary": "Log in with username and password",
                "operationId": "authLogin",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/LoginRequest"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "OK",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/AuthTokenResponse"
                                }
                            }
                        }
                    },
                    "422": {
                        "description": "Invalid credentials"
                    },
                    "429": {
                        "description": "Rate limited"
                    }
                }
            }
        },
        "/auth/logout": {
            "post": {
                "tags": [
                    "auth"
                ],
                "summary": "Revoke the current Sanctum token",
                "operationId": "authLogout",
                "responses": {
                    "204": {
                        "description": "No Content"
                    },
                    "401": {
                        "description": "Unauthenticated"
                    }
                },
                "security": [
                    {
                        "bearerAuth": []
                    }
                ]
            }
        },
        "/auth/me": {
            "get": {
                "tags": [
                    "auth"
                ],
                "summary": "Get the authenticated user",
                "operationId": "authMe",
                "responses": {
                    "200": {
                        "description": "OK",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/MeResponse"
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "Unauthenticated"
                    }
                },
                "security": [
                    {
                        "bearerAuth": []
                    }
                ]
            }
        },
        "/auth/claim-username": {
            "post": {
                "tags": [
                    "auth"
                ],
                "summary": "Set username for an OAuth-created user",
                "operationId": "authClaimUsername",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/ClaimUsernameRequest"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "OK",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/MeResponse"
                                }
                            }
                        }
                    },
                    "422": {
                        "description": "Validation error"
                    }
                },
                "security": [
                    {
                        "bearerAuth": []
                    }
                ]
            }
        },
        "/backgrounds": {
            "get": {
                "tags": [
                    "Backgrounds"
                ],
                "operationId": "listBackgrounds",
                "parameters": [
                    {
                        "name": "page",
                        "in": "query",
                        "schema": {
                            "type": "integer",
                            "minimum": 1
                        }
                    },
                    {
                        "name": "per_page",
                        "in": "query",
                        "schema": {
                            "type": "integer",
                            "maximum": 50,
                            "minimum": 1
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/BackgroundCollection"
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "Unauthenticated"
                    }
                },
                "security": [
                    {
                        "sanctum": []
                    }
                ]
            }
        },
        "/backgrounds/upload": {
            "post": {
                "tags": [
                    "Backgrounds"
                ],
                "operationId": "uploadBackground",
                "requestBody": {
                    "required": true,
                    "content": {
                        "multipart/form-data": {
                            "schema": {
                                "$ref": "#/components/schemas/UploadBackgroundRequest"
                            }
                        }
                    }
                },
                "responses": {
                    "201": {
                        "description": "Created",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/BackgroundResourceEnvelope"
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "Unauthenticated"
                    },
                    "422": {
                        "description": "Validation failed"
                    }
                },
                "security": [
                    {
                        "sanctum": []
                    }
                ]
            }
        },
        "/backgrounds/generate": {
            "post": {
                "tags": [
                    "Backgrounds"
                ],
                "operationId": "generateBackground",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/GenerateBackgroundRequest"
                            }
                        }
                    }
                },
                "responses": {
                    "201": {
                        "description": "Created",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/BackgroundResourceEnvelope"
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "Unauthenticated"
                    },
                    "422": {
                        "description": "Validation failed"
                    },
                    "429": {
                        "description": "Rate limited"
                    },
                    "503": {
                        "description": "Daily global ceiling exhausted"
                    }
                },
                "security": [
                    {
                        "sanctum": []
                    }
                ]
            }
        },
        "/backgrounds/{background}/select": {
            "patch": {
                "tags": [
                    "Backgrounds"
                ],
                "operationId": "selectBackground",
                "parameters": [
                    {
                        "name": "background",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "string",
                            "format": "ulid",
                            "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/BackgroundResourceEnvelope"
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "Unauthenticated"
                    },
                    "403": {
                        "description": "Forbidden"
                    },
                    "404": {
                        "description": "Not found"
                    },
                    "409": {
                        "description": "Concurrent select race"
                    }
                },
                "security": [
                    {
                        "sanctum": []
                    }
                ]
            }
        },
        "/backgrounds/{background}": {
            "delete": {
                "tags": [
                    "Backgrounds"
                ],
                "operationId": "deleteBackground",
                "parameters": [
                    {
                        "name": "background",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "string",
                            "format": "ulid",
                            "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
                        }
                    }
                ],
                "responses": {
                    "204": {
                        "description": "Soft-deleted"
                    },
                    "401": {
                        "description": "Unauthenticated"
                    },
                    "403": {
                        "description": "Forbidden"
                    },
                    "404": {
                        "description": "Not found"
                    }
                },
                "security": [
                    {
                        "sanctum": []
                    }
                ]
            }
        },
        "/fishes": {
            "get": {
                "tags": [
                    "Fishes"
                ],
                "operationId": "listFishes",
                "parameters": [
                    {
                        "name": "search",
                        "in": "query",
                        "schema": {
                            "type": "string"
                        }
                    },
                    {
                        "name": "breed",
                        "in": "query",
                        "schema": {
                            "type": "string"
                        }
                    },
                    {
                        "name": "color",
                        "in": "query",
                        "schema": {
                            "type": "string"
                        }
                    },
                    {
                        "name": "sort",
                        "in": "query",
                        "schema": {
                            "type": "string",
                            "enum": [
                                "name",
                                "breed",
                                "created_at",
                                "size"
                            ]
                        }
                    },
                    {
                        "name": "direction",
                        "in": "query",
                        "schema": {
                            "type": "string",
                            "enum": [
                                "asc",
                                "desc"
                            ]
                        }
                    },
                    {
                        "name": "page",
                        "in": "query",
                        "schema": {
                            "type": "integer",
                            "minimum": 1
                        }
                    },
                    {
                        "name": "per_page",
                        "in": "query",
                        "schema": {
                            "type": "integer",
                            "maximum": 100,
                            "minimum": 1
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/PaginatedFishCollection"
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "Unauthenticated"
                    }
                },
                "security": [
                    {
                        "sanctum": []
                    }
                ]
            },
            "post": {
                "tags": [
                    "Fishes"
                ],
                "operationId": "createFish",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/StoreFishRequest"
                            }
                        }
                    }
                },
                "responses": {
                    "201": {
                        "description": "Created",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/FishResourceEnvelope"
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "Unauthenticated"
                    },
                    "422": {
                        "description": "Validation error"
                    }
                },
                "security": [
                    {
                        "sanctum": []
                    }
                ]
            }
        },
        "/fishes/{fish}": {
            "get": {
                "tags": [
                    "Fishes"
                ],
                "operationId": "getFish",
                "parameters": [
                    {
                        "name": "fish",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "string",
                            "format": "ulid",
                            "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/FishResourceEnvelope"
                                }
                            }
                        }
                    },
                    "403": {
                        "description": "Forbidden"
                    },
                    "404": {
                        "description": "Not found"
                    }
                },
                "security": [
                    {
                        "sanctum": []
                    }
                ]
            },
            "delete": {
                "tags": [
                    "Fishes"
                ],
                "operationId": "deleteFish",
                "parameters": [
                    {
                        "name": "fish",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "string",
                            "format": "ulid",
                            "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
                        }
                    }
                ],
                "responses": {
                    "204": {
                        "description": "No content"
                    },
                    "403": {
                        "description": "Forbidden"
                    },
                    "404": {
                        "description": "Not found"
                    }
                },
                "security": [
                    {
                        "sanctum": []
                    }
                ]
            },
            "patch": {
                "tags": [
                    "Fishes"
                ],
                "operationId": "updateFish",
                "parameters": [
                    {
                        "name": "fish",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "string",
                            "format": "ulid",
                            "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
                        }
                    }
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/UpdateFishRequest"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "OK",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/FishResourceEnvelope"
                                }
                            }
                        }
                    },
                    "403": {
                        "description": "Forbidden"
                    },
                    "422": {
                        "description": "Validation error"
                    }
                },
                "security": [
                    {
                        "sanctum": []
                    }
                ]
            }
        },
        "/fishes/breeds": {
            "get": {
                "tags": [
                    "Fishes"
                ],
                "operationId": "listBreeds",
                "responses": {
                    "200": {
                        "description": "OK",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/FishBreedCollection"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/auth/google/redirect": {
            "get": {
                "tags": [
                    "auth"
                ],
                "summary": "Redirect to Google OAuth consent",
                "operationId": "authGoogleRedirect",
                "responses": {
                    "302": {
                        "description": "Redirect"
                    },
                    "404": {
                        "description": "OAuth disabled"
                    }
                }
            }
        },
        "/auth/google/callback": {
            "get": {
                "tags": [
                    "auth"
                ],
                "summary": "Receive Google OAuth callback and bootstrap a session",
                "operationId": "authGoogleCallback",
                "responses": {
                    "302": {
                        "description": "Redirect to frontend finish page"
                    },
                    "404": {
                        "description": "OAuth disabled"
                    }
                }
            }
        },
        "/health": {
            "get": {
                "tags": [
                    "meta"
                ],
                "summary": "Service liveness probe",
                "operationId": "getHealth",
                "responses": {
                    "200": {
                        "description": "OK",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/HealthResponse"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/repos/{owner}/{repo}/aquarium": {
            "get": {
                "tags": [
                    "Repo Aquarium"
                ],
                "operationId": "getRepoAquarium",
                "parameters": [
                    {
                        "name": "owner",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "string"
                        }
                    },
                    {
                        "name": "repo",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "string"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/RepoAquariumResponse"
                                }
                            }
                        }
                    },
                    "404": {
                        "description": "Not found",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/RepoAquariumErrorResponse"
                                }
                            }
                        }
                    },
                    "403": {
                        "description": "Forbidden",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/RepoAquariumErrorResponse"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/repos/{owner}/{repo}/fork-to-my-aquarium": {
            "post": {
                "tags": [
                    "Repo Aquarium"
                ],
                "operationId": "forkRepoAquarium",
                "parameters": [
                    {
                        "name": "owner",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "string"
                        }
                    },
                    {
                        "name": "repo",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "string"
                        }
                    }
                ],
                "responses": {
                    "201": {
                        "description": "Created",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/RepoForkResponse"
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "Unauthenticated"
                    },
                    "404": {
                        "description": "Not found"
                    }
                },
                "security": [
                    {
                        "sanctum": []
                    }
                ]
            }
        }
    },
    "components": {
        "schemas": {
            "HealthResponse": {
                "required": [
                    "ok",
                    "version"
                ],
                "properties": {
                    "ok": {
                        "type": "boolean",
                        "example": true
                    },
                    "version": {
                        "type": "string",
                        "example": "1.0.0"
                    }
                },
                "type": "object"
            },
            "ClaimUsernameRequest": {
                "required": [
                    "username"
                ],
                "properties": {
                    "username": {
                        "type": "string",
                        "pattern": "^[A-Za-z0-9_]{3,32}$"
                    }
                },
                "type": "object"
            },
            "LoginRequest": {
                "required": [
                    "username",
                    "password"
                ],
                "properties": {
                    "username": {
                        "type": "string"
                    },
                    "password": {
                        "type": "string"
                    }
                },
                "type": "object"
            },
            "RegisterRequest": {
                "required": [
                    "username",
                    "email",
                    "password",
                    "password_confirmation"
                ],
                "properties": {
                    "username": {
                        "type": "string",
                        "pattern": "^[A-Za-z0-9_]{3,32}$",
                        "example": "kimerran"
                    },
                    "email": {
                        "type": "string",
                        "format": "email"
                    },
                    "password": {
                        "type": "string",
                        "example": "a-strong-pass-123!",
                        "minLength": 10
                    },
                    "password_confirmation": {
                        "type": "string"
                    }
                },
                "type": "object"
            },
            "GenerateBackgroundRequest": {
                "required": [
                    "prompt"
                ],
                "properties": {
                    "prompt": {
                        "type": "string",
                        "maxLength": 500,
                        "minLength": 3
                    },
                    "aspect_ratio": {
                        "type": "string",
                        "default": "16:9",
                        "enum": [
                            "16:9",
                            "3:2",
                            "1:1"
                        ]
                    }
                },
                "type": "object"
            },
            "UploadBackgroundRequest": {
                "required": [
                    "image"
                ],
                "properties": {
                    "image": {
                        "description": "Layered MIME defense: this FormRequest's `mimes:` rule is the cheap\nfirst gate (finfo). The deep gate lives in BackgroundImageProcessor\n(Intervention v3 actually decodes the file). Both must pass.",
                        "type": "string",
                        "format": "binary"
                    }
                },
                "type": "object"
            },
            "StoreFishRequest": {
                "required": [
                    "nickname",
                    "breed",
                    "color_hex",
                    "size"
                ],
                "properties": {
                    "nickname": {
                        "type": "string",
                        "maxLength": 40,
                        "minLength": 1
                    },
                    "breed": {
                        "type": "string",
                        "example": "guppy"
                    },
                    "color_hex": {
                        "type": "string",
                        "pattern": "^#[0-9A-Fa-f]{6}$",
                        "example": "#FF6B9D"
                    },
                    "size": {
                        "type": "integer",
                        "maximum": 100,
                        "minimum": 1
                    }
                },
                "type": "object"
            },
            "UpdateFishRequest": {
                "properties": {
                    "nickname": {
                        "type": "string",
                        "maxLength": 40,
                        "minLength": 1
                    },
                    "color_hex": {
                        "type": "string",
                        "pattern": "^#[0-9A-Fa-f]{6}$"
                    },
                    "size": {
                        "type": "integer",
                        "maximum": 100,
                        "minimum": 1
                    }
                },
                "type": "object"
            },
            "BackgroundResource": {
                "required": [
                    "id",
                    "kind",
                    "storage_key",
                    "signed_url",
                    "width",
                    "height",
                    "is_active",
                    "created_at"
                ],
                "properties": {
                    "id": {
                        "type": "string",
                        "format": "ulid",
                        "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$",
                        "example": "01HG5W7DZ8KX9F3N2VYRMPQABT"
                    },
                    "kind": {
                        "type": "string",
                        "enum": [
                            "upload",
                            "generated",
                            "preset"
                        ]
                    },
                    "storage_key": {
                        "type": "string"
                    },
                    "signed_url": {
                        "type": "string",
                        "format": "uri"
                    },
                    "width": {
                        "type": "integer"
                    },
                    "height": {
                        "type": "integer"
                    },
                    "prompt": {
                        "type": "string",
                        "nullable": true
                    },
                    "is_active": {
                        "type": "boolean"
                    },
                    "created_at": {
                        "type": "string",
                        "format": "date-time"
                    }
                },
                "type": "object"
            },
            "FishBreedResource": {
                "required": [
                    "id",
                    "label",
                    "min_size",
                    "max_size",
                    "default_color",
                    "sprite_key"
                ],
                "properties": {
                    "id": {
                        "type": "string"
                    },
                    "label": {
                        "type": "string"
                    },
                    "min_size": {
                        "type": "integer"
                    },
                    "max_size": {
                        "type": "integer"
                    },
                    "default_color": {
                        "type": "string"
                    },
                    "sprite_key": {
                        "type": "string"
                    },
                    "vertical_band_preference": {
                        "type": "string",
                        "nullable": true,
                        "enum": [
                            "bottom"
                        ]
                    }
                },
                "type": "object"
            },
            "FishResource": {
                "required": [
                    "id",
                    "nickname",
                    "breed",
                    "color_hex",
                    "size",
                    "source",
                    "created_at",
                    "updated_at"
                ],
                "properties": {
                    "id": {
                        "type": "string",
                        "format": "ulid",
                        "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$",
                        "example": "01HG5W7DZ8KX9F3N2VYRMPQABT"
                    },
                    "nickname": {
                        "type": "string"
                    },
                    "breed": {
                        "type": "string"
                    },
